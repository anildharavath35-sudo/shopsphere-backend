# ------------------------------------------------------------------
# ShopSphere Server environment variables
# Copy this file to .env and fill in real values.
# NEVER commit your .env file.
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string (DATABASE_URL)
# Example: postgresql://<user>:<password>@localhost:5432/shopsphere?schema=public
DATABASE_URL="postgresql://postgres:cmr%20anil@localhost:5432/shopsphere?schema=public"

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:5173

# Razorpay - https://dashboard.razorpay.com/app/keys
# Leave empty while PAYMENT_DEV_MODE=true is set
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dev-mode payments: allows full checkout flow (order + "simulate payment")
# without real Razorpay keys. Set to false once Razorpay keys are added.
PAYMENT_DEV_MODE=true

# Cloudinary - https://cloudinary.com/console
# App still works without these (product images are stored as URLs from seed data).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Free-delivery threshold and COD delivery charge (INR)
FREE_DELIVERY_THRESHOLD=999
DELIVERY_CHARGE=49

# Admin seed account (used by `npm run seed`)
ADMIN_EMAIL=admin@shopsphere.com
ADMIN_PASSWORD=Admin@123