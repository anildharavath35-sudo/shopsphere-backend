{
  "name": "shopsphere-server",
  "version": "1.0.0",
  "description": "ShopSphere e-commerce REST API (Express + PostgreSQL + Prisma)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "npx prisma migrate deploy && node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset"
  },
  "keywords": [
    "ecommerce",
    "express",
    "postgresql",
    "prisma",
    "razorpay"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "prisma": "^6.2.1",
    "razorpay": "^2.9.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "prisma": {
    "seed": "node src/seed/seed.js"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
